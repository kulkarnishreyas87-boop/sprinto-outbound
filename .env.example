# Copy to .env and fill in. Never commit .env.

# The ONLY address the pipeline will ever send to.
# With Resend's test sender (no verified domain), this must be the address
# your Resend account was created with.
MY_EMAIL=

# LLM key for the provider set in config (models.provider). v1 uses Gemini.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HUNTER_API_KEY=
RESEND_API_KEY=

# Optional: only change after verifying a domain in Resend.
RESEND_FROM=onboarding@resend.dev
